    "graphql": "^16.12.0",
    "graphql-request": "^7.3.4"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "scripts": {
    "start": "node src/signing-proxy.js",
    "build:privacy": "tsc -p tsconfig.privacy.json; echo '{ \"type\": \"commonjs\" }' > src/privacy-dist/package.json"
  },
