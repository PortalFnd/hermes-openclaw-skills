#!/bin/bash
# Make an HTTP request that auto-pays any x402 (402 Payment Required) charge
# PRIVATELY from your shielded note balance (burner wallet + ZK proof).
# Usage: private-fetch <url> [method] [body]
#   private-fetch https://api.example.com/x402/endpoint
#   private-fetch https://api.example.com/x402/submit POST '{"q":"hi"}'
URL="$1"
METHOD="${2:-GET}"
BODY="$3"
if [ -z "$URL" ]; then echo '{"error":"Usage: private-fetch <url> [method] [body]"}'; exit 1; fi
PAYLOAD="{\"url\":\"$URL\",\"method\":\"$METHOD\""
if [ -n "$BODY" ]; then PAYLOAD="$PAYLOAD,\"body\":$BODY"; fi
PAYLOAD="$PAYLOAD}"
curl -sf -X POST http://127.0.0.1:8128/privacy/fetch -H 'Content-Type: application/json' -d "$PAYLOAD" 2>/dev/null || echo '{"error":"signing proxy not running or privacy disabled"}'
